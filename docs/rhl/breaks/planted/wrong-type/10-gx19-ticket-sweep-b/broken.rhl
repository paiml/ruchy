use vocabulary fleet v1
use vocabulary tickets v1

job "gx19 ticket sweep"
  runs on host gx19
  every 1 hour
  may read disk
  may write tickets
  may call tickets

  let free be tickets filed in "paiml/fleet-ops"

  when free is below "low"
    file ticket in repo "paiml/fleet-ops" with
      title "gx19 ticket sweep"
      label "tickets"
    end
  end

  expect ticket count is at most 1

  example "gx19 ticket sweep example"
    given free is 1 gb
    then ticket count is 1
  end
end
