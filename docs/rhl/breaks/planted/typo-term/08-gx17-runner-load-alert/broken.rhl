use vocabulary fleet v1
use vocabulary tickets v1

job "gx17 runner load alert"
  runs on host gx17
  every 1 hour
  may read disk
  may write tickets
  may call tickets

  let free be runer load of "runner-02"

  when free is below 85 gb
    file ticket in repo "paiml/ci-ops" with
      title "gx17 runner load alert"
      label "runner"
    end
  end

  expect ticket count is at most 1

  example "gx17 runner load alert example"
    given free is 90 gb
    then ticket count is 1
  end
end
