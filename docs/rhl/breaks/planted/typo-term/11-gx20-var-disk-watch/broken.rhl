use vocabulary fleet v1
use vocabulary tickets v1

job "gx20 var disk watch"
  runs on host gx20
  every 1 hour
  may read disk
  may write tickets
  may call tickets

  let free be disk fre of "/var"

  when free is below 30 gb
    file ticket in repo "paiml/infra" with
      title "gx20 var disk watch"
      label "fleet"
    end
  end

  expect ticket count is at most 1

  example "gx20 var disk watch example"
    given free is 20 gb
    then ticket count is 1
  end
end
