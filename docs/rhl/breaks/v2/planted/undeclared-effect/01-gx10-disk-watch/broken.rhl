use vocabulary fleet v2
use vocabulary tickets v2

job "gx10 disk watch"
  runs on host gx10
  every 1 hour
  may read disk

  let free be disk free of "/"

  when free is below 100 GB
    file ticket in repo "paiml/infra" with
      title "gx10 disk watch"
      label "fleet"
    end
  end

  expect ticket count is at most 1

  example "gx10 disk watch example"
    given free is 90 GB
    then ticket count is 1
  end
end
