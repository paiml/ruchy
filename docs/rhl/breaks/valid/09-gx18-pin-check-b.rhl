use vocabulary fleet v1
use vocabulary tickets v1

job "gx18 pin check"
  runs on host gx18
  every 1 hour
  may read disk
  may write tickets
  may call tickets

  let free be pin status of "gx18"

  when free is below 1 gb
    file ticket in repo "paiml/infra" with
      title "gx18 pin check"
      label "pin"
    end
  end

  expect ticket count is at most 1

  example "gx18 pin check example"
    given free is 1 gb
    then ticket count is 1
  end
end
